# Mẫu biến môi trường. Chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# --- TURN cho signaling_server.py (webrtc_config.py) ---
# Tài khoản TURN Metered của nhóm: dashboard Metered > TURN Server > Credentials
TURN_USERNAME=
TURN_CREDENTIAL=
# Không bắt buộc:
# METERED_APP_NAME=      # lấy credential tạm thời qua REST API (kèm METERED_API_KEY)
# METERED_API_KEY=
# TURN_URLS=             # TURN tự dựng (coturn), các URL cách nhau bằng dấu phẩy
# TURN_FALLBACK_OPENRELAY=1

# --- LiveKit cho api.js (cấp token, Tuần 2 TV2) ---
# https://cloud.livekit.io > Settings > Keys
LIVEKIT_URL=wss://<ten-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
