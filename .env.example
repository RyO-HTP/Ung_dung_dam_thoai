# Mẫu biến môi trường. Chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env (đã có trong .gitignore).

# --- LiveKit (api.js cấp token) ---
# Lấy trên https://cloud.livekit.io > Settings > Keys
LIVEKIT_URL=wss://<ten-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- TURN (webrtc_config.py, dùng bởi signaling_server.py) ---
# Lấy trên dashboard Metered > TURN Server > Credentials
TURN_USERNAME=
TURN_CREDENTIAL=
# Không bắt buộc, có giá trị mặc định:
# TURN_HOST=global.relay.metered.ca
# STUN_URL=stun:stun.relay.metered.ca:80
